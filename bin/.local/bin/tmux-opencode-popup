#!/usr/bin/env bash
# Toggle an opencode popup. If the popup is already showing, this closes it.
# If not, it creates/reattaches a persistent opencode tmux session in a popup.
set -uo pipefail

path="${1:-$PWD}"

# Derive a stable session name from the directory
hash=$(printf '%s\n' "$path" | md5 -q 2>/dev/null || printf '%s\n' "$path" | md5sum | cut -c1-8)
session="opencode-${hash:0:8}"

# If we're already inside this session (popup is open), detach to close it
current="$(tmux display-message -p '#S' 2>/dev/null)"
if [ "$current" = "$session" ]; then
  tmux detach-client
  exit 0
fi

# Create the session if it doesn't exist
tmux has-session -t "$session" 2>/dev/null ||
  tmux new-session -d -s "$session" -c "$path" "opencode"

# Show popup (if popup is already visible, display-popup toggles it off)
tmux display-popup -w 90% -h 90% -E "tmux attach-session -t '$session'"
